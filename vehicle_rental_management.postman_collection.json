	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Automatically calculate current month YYYY-MM",
					"var now = new Date();",
					"var year = now.getFullYear();",
					"var month = String(now.getMonth() + 1).padStart(2, '0');",
					"pm.collectionVariables.set('currentMonth', `${year}-${month}`);",
					"",
					"// Automatically generate dynamic non-overlapping future dates",
					"var today = new Date();",
					"var randomOffset = Math.floor(Math.random() * 50) + 10;",
					"var start = new Date(today.getTime() + randomOffset * 86400000);",
					"var end = new Date(start.getTime() + 4 * 86400000);",
					"pm.collectionVariables.set('startDate', start.toISOString().split('T')[0]);",
					"pm.collectionVariables.set('endDate', end.toISOString().split('T')[0]);",
					"",
					"// Automatically generate dynamic unique vehicle data",
					"var randVehicleNum = Math.floor(1000 + Math.random() * 9000);",
					"pm.collectionVariables.set('randomPlateNumber', `DHAKA-METRO-KA-${randVehicleNum}`);",
					"pm.collectionVariables.set('randomVehicleName', `Toyota Axio Turbo ${randVehicleNum}`);",
					"",
					"// Automatically generate dynamic customer data",
					"var randCustNum = Math.floor(1000 + Math.random() * 9000);",
					"pm.collectionVariables.set('customerName', `Customer ${randCustNum}`);",
					"pm.collectionVariables.set('customerPhone', `+88017${Math.floor(10000000 + Math.random() * 90000000)}`);"
				]
			}
		}
	]
}